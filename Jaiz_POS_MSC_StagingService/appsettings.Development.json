{
  "ConnectionStrings": {
    "DefaultConnection": "##########################################################################################################################"
  },
  "appConfiguration": {
    "imalConnString": "##########################################################################################################################",
    "Folders": {
      "Filtered": "C:\\MSC\\Uploads\\filtered",
      "Processing": "C:\\MSC\\Uploads\\processing",
      "Completed": "C:\\MSC\\Uploads\\completed",
      "Failed": "C:\\MSC\\Uploads\\failed"
    }
  },

  "ServiceSettings": {
    "PollingIntervalSeconds": 60
  },

  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\MSCLogs\\MSCS_StagingService\\service-.log",
          "rollingInterval": "Day"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\MSCLogs\\MSCS_StagingService\\error-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Error"
        }
      },

      {
        "Name": "File",
        "Args": {
          "path": "C:\\MSCLogs\\MSCS_StagingService\\fatal-.log",
          "rollingInterval": "Day",
          "restrictedToMinimumLevel": "Fatal"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}